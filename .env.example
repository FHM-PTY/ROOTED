# ==============================================================================
# ROOTED™ (Le Benkeleng) Environment Configuration
# Phase 1 / Week 1 Roadmap: PostgreSQL 16 & Supabase Cloud Backend
# ==============================================================================

# 1. Supabase Project REST URL
# Find in: Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public API Key
# Safe to expose in the browser client; protected by PostgreSQL Row-Level Security (RLS)
# Find in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> `anon` `public`
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ==============================================================================
# Upcoming Commercial Horizons (Phases 2 & 3 Roadmap)
# ==============================================================================
# Phase 2: Payment Settlement Rails (Capitec Pay / Payflex / Peach Payments)
# VITE_PEACH_ENTITY_ID=
# VITE_PAYFLEX_MERCHANT_KEY=

# Phase 3: Smart Locker Logistics (Bob Go / Pargo Automated Waybills)
# VITE_BOB_GO_API_KEY=
